  <diagram id="LTV8nWzkFr9GO73kpWWn" name="usecase">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml UseCase_Tong_Quat_Quan_Ly_Ho_So_Benh_An\ntitle HỆ THỐNG QUẢN LÝ HỒ SƠ BỆNH ÁN - BỆNH VIỆN ĐA KHOA QUỐC TẾ\\nUSE CASE DIAGRAM TỔNG QUÁT (BÀI 5)\n\nleft to right direction\nskinparam packageStyle rectangle\nskinparam shadowing false\nskinparam monochrome true\nskinparam handwritten false\n\nskinparam usecase {\n    BackgroundColor #FFFFFF\n    BorderColor #000000\n    FontSize 12\n}\n\nskinparam actor {\n    BackgroundColor #FFFFFF\n    BorderColor #000000\n    FontSize 12\n}\n\n&#39; ================= KHAI BÁO CÁC ACTOR =================\nactor \&quot;Bệnh nhân\&quot; as BN\nactor \&quot;Bác sĩ điều trị\&quot; as BS\nactor \&quot;Nhân viên CSKH\&quot; as CSKH\nactor \&quot;Kỹ thuật viên Xét nghiệm\&quot; as KTV\nactor \&quot;Nhân viên Viện phí\&quot; as NVVP\n\n&#39; ================= BIÊN GIỚI HỆ THỐNG =================\nrectangle \&quot;Hệ thống Quản lý Hồ sơ Bệnh án\&quot; {\n    usecase \&quot;UC01: Điền phiếu đăng ký khám bệnh\&quot; as UC01\n    usecase \&quot;UC02: Đóng lệ phí hằng năm\&quot; as UC02\n    usecase \&quot;UC03: Cấp phát hồ sơ bệnh án\&quot; as UC03\n    usecase \&quot;UC04: Tra cứu hồ sơ bệnh án\&quot; as UC04\n    usecase \&quot;UC05: Đặt hẹn khám định kỳ theo quý\&quot; as UC05\n    usecase \&quot;UC06: Khám bệnh &amp; Ghi nhận triệu chứng\&quot; as UC06\n    usecase \&quot;UC07: Chỉ định xét nghiệm cần thiết\&quot; as UC07\n    usecase \&quot;UC08: Thực hiện xét nghiệm &amp; Nhập kết quả\&quot; as UC08\n    usecase \&quot;UC09: Kê toa thuốc điều trị\&quot; as UC09\n    usecase \&quot;UC10: Khám sức khỏe định kỳ &amp; Tầm soát\&quot; as UC10\n    usecase \&quot;UC11: Làm thủ tục xuất viện &amp; Thanh toán\&quot; as UC11\n    usecase \&quot;UC12: Số hóa dữ liệu đợt khám lên máy tính\&quot; as UC12\n    usecase \&quot;UC13: Theo dõi diễn biến bệnh &amp; Phản ứng phụ\&quot; as UC13\n    usecase \&quot;UC14: Giám sát hiệu quả &amp; Trách nhiệm bác sĩ\&quot; as UC14\n}\n\n&#39; ================= LIÊN KẾT BỆNH NHÂN =================\nBN --&gt; UC01\nBN --&gt; UC02\nBN --&gt; UC05\nBN --&gt; UC06\nBN --&gt; UC10\nBN --&gt; UC11\n\n&#39; ================= LIÊN KẾT BÁC SĨ ĐIỀU TRỊ =================\nBS --&gt; UC04\nBS --&gt; UC06\nBS --&gt; UC07\nBS --&gt; UC09\nBS --&gt; UC10\nBS --&gt; UC13\n\n&#39; ================= LIÊN KẾT NHÂN VIÊN CSKH =================\nCSKH --&gt; UC01\nCSKH --&gt; UC02\nCSKH --&gt; UC03\nCSKH --&gt; UC04\nCSKH --&gt; UC05\nCSKH --&gt; UC12\nCSKH --&gt; UC13\nCSKH --&gt; UC14\n\n&#39; ================= LIÊN KẾT KỸ THUẬT VIÊN XÉT NGHIỆM =================\nKTV --&gt; UC08\n\n&#39; ================= LIÊN KẾT NHÂN VIÊN VIỆN PHÍ =================\nNVVP --&gt; UC11\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="tTeHmH9wxWK783L8sK4z-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
