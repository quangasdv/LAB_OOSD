<mxfile host="app.diagrams.net" pages="5">
  <diagram name="class" id="SKAZLEW2HLYUbUB-Ds7x">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml Class_Phan_Tich_Quan_Ly_Ho_So_Benh_An\n\nskinparam style strictuml\nskinparam classAttributeIconStyle none\nskinparam linetype ortho\nskinparam roundcorner 0\nskinparam monochrome true\nskinparam packageStyle rectangle\nskinparam shadowing false\nskinparam classFontSize 12\nskinparam classFontBold true\nskinparam classBackgroundColor #FFFFFF\nskinparam classBorderColor #000000\nskinparam arrowColor #000000\nskinparam arrowFontColor #000000\n\n&#39; Ẩn ngăn phương thức đúng chuẩn Class Diagram phân tích (tương tự class lab05.drawio)\nhide methods\n\n&#39; ==========================================================\n&#39; KHỐI 1: BỆNH NHÂN, TIẾP NHẬN ĐĂNG KÝ VÀ LỆ PHÍ NĂM\n&#39; ==========================================================\nclass BenhNhan {\n    String MaBN\n    String HoTen\n    Date NgaySinh\n    String GioiTinh\n    String DiaChi\n    String SoDienThoai\n    String Anh3x4\n}\n\nclass PhieuDangKy {\n    String MaPhieuDK\n    Date NgayDangKy\n    Boolean TrangThaiDuyet\n}\n\nclass LePhiNam {\n    String MaLePhi\n    Date NgayDong\n    Decimal SoTien\n    Date NgayHetHan\n    String TrangThai\n}\n\n&#39; ==========================================================\n&#39; KHỐI 2: HỒ SƠ BỆNH ÁN VÀ ĐỢT ĐIỀU TRỊ (PHIẾU KHÁM BỆNH)\n&#39; ==========================================================\nclass HoSoBenhAn {\n    String MaHoSo\n    Date NgayCap\n    String ThongTinTrangBia\n    String GhiChuDienBien\n    String TienSuPhanUngThuoc\n}\n\nclass PhieuKhamBenh {\n    String MaPhieuKham\n    DateTime NgayGioKham\n    String LoaiKham\n    String ChanDoanSoBo\n    String ChanDoanXacDinh\n    String KetLuanMamBenh\n    String HieuQuaDieuTri\n    String TrangThai\n}\n\n&#39; ==========================================================\n&#39; KHỐI 3: CƠ CẤU CHUYÊN KHOA VÀ BÁC SĨ ĐIỀU TRỊ\n&#39; ==========================================================\nclass KhoaDieuTri {\n    String MaKhoa\n    String TenKhoa\n    String TruongKhoa\n}\n\nclass BacSi {\n    String MaBS\n    String HoTenBS\n    String ChuyenKhoa\n    String SoDienThoai\n}\n\n&#39; ==========================================================\n&#39; KHỐI 4: LÂM SÀNG, XÉT NGHIỆM VÀ TOA THUỐC ĐIỀU TRỊ\n&#39; ==========================================================\nclass TrieuChung {\n    String MaTrieuChung\n    String TenTrieuChung\n    Float ThanNhiet\n    String HuyetAp\n    Int NhipTim\n    String MoTaChiTiet\n}\n\nclass XetNghiem {\n    String MaXN\n    String TenXetNghiem\n    DateTime NgayGioChiDinh\n    DateTime NgayGioThucHien\n    String KetQua\n    String ChiSoBinhThuong\n    String KetLuan\n}\n\nclass ToaThuoc {\n    String MaToaThuoc\n    Date NgayKeToa\n    String LoiDanBacSi\n    String CanhBaoPhanUngPhu\n}\n\nclass ChiTietToaThuoc {\n    String MaCTToa\n    String TenThuoc\n    String HamLuong\n    Int SoLuong\n    String DonViTinh\n    String LieuLuong\n    String CachUong\n}\n\n&#39; ==========================================================\n&#39; KHỐI 5: QUẢN LÝ CUỘC HẸN VÀ KHÁM ĐỊNH KỲ THEO QUÝ\n&#39; ==========================================================\nclass CuocHenDinhKy {\n    String MaCuocHen\n    Date NgayGoiHen\n    DateTime NgayGioKhamHen\n    String ThoiGianRanhCuaBN\n    String TrangThaiHen\n}\n\n&#39; ==========================================================\n&#39; KHỐI 6: VIỆN PHÍ, XUẤT VIỆN VÀ ĐIỀU PHỐI CSKH\n&#39; ==========================================================\nclass HoaDonVienPhi {\n    String MaHoaDon\n    DateTime NgayThanhToan\n    Decimal TienKham\n    Decimal TienXetNghiem\n    Decimal TienThuoc\n    Decimal TongTien\n    String TrangThai\n}\n\nclass NhanVienCSKH {\n    String MaNV\n    String HoTenNV\n    String SoDienThoai\n}\n\n&#39; ==========================================================\n&#39; MỐI QUAN HỆ &amp; BẢN SỐ (RELATIONSHIPS &amp; MULTIPLICITIES)\n&#39; ==========================================================\n\n&#39; Nhánh Bệnh nhân, Phiếu đăng ký &amp; Lệ phí năm\nBenhNhan \&quot;1\&quot; *-- \&quot;1\&quot; PhieuDangKy\nBenhNhan \&quot;1\&quot; o-- \&quot;1..*\&quot; LePhiNam\nBenhNhan \&quot;1\&quot; *-- \&quot;1\&quot; HoSoBenhAn\nBenhNhan \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CuocHenDinhKy\n\n&#39; Nhánh Hồ sơ bệnh án chứa các trang phiếu khám bệnh\nHoSoBenhAn \&quot;1\&quot; *-- \&quot;0..*\&quot; PhieuKhamBenh\n\n&#39; Nhánh Cơ cấu chuyên khoa &amp; Bác sĩ điều trị\nKhoaDieuTri \&quot;1\&quot; o-- \&quot;1..*\&quot; BacSi\nKhoaDieuTri \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; PhieuKhamBenh\nBacSi \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; PhieuKhamBenh\n\n&#39; Nhánh Chi tiết đợt khám: Triệu chứng, Xét nghiệm &amp; Toa thuốc\nPhieuKhamBenh \&quot;1\&quot; *-- \&quot;1..*\&quot; TrieuChung\nPhieuKhamBenh \&quot;1\&quot; *-- \&quot;0..*\&quot; XetNghiem\nPhieuKhamBenh \&quot;1\&quot; *-- \&quot;0..1\&quot; ToaThuoc\nToaThuoc \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietToaThuoc\n\n&#39; Nhánh Khám định kỳ từ cuộc hẹn\nCuocHenDinhKy \&quot;0..1\&quot; &lt;-- \&quot;1\&quot; PhieuKhamBenh\n\n&#39; Nhánh Hoàn tất xuất viện &amp; Viện phí\nPhieuKhamBenh \&quot;1\&quot; --&gt; \&quot;1\&quot; HoaDonVienPhi\n\n&#39; Nhánh Điều phối của Phòng Chăm sóc khách hàng\nNhanVienCSKH \&quot;1\&quot; --&gt; \&quot;0..*\&quot; LePhiNam\nNhanVienCSKH \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CuocHenDinhKy\nNhanVienCSKH \&quot;1\&quot; ..&gt; \&quot;0..*\&quot; HoSoBenhAn\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="to_nIYay2tiky3FpaSFz-316">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
