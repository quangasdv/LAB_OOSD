        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide circle\nskinparam classAttributeIconSize 0\nskinparam monochrome true\nskinparam shadowing false\nskinparam roundcorner 0\nskinparam defaultFontName \&quot;Helvetica\&quot;\nskinparam defaultFontSize 12\nskinparam linetype ortho\n\n&#39; ==========================================\n&#39; DANH SÁCH CÁC LỚP THỰC THỂ\n&#39; ==========================================\nclass NhanVien {\n    MaNhanVien: string\n    Ho: string\n    Ten: string\n    Phai: string\n    NgaySinh: DateTime\n    ChucVu: string\n    SoDienThoai: string\n}\n\nclass NhaXuatBan {\n    MaNhaXuatBan: string\n    DiaChi: string\n    SoDienThoai: string\n}\n\nclass TheLoai {\n    MaTheLoai: string*\n    TenTheLoai: string\n}\n\nclass DocGia {\n    MaDocGia: string\n    Ho: string\n    Ten: string\n    NgaySinh: DateTime\n    Phai: string\n    SoDienThoai: string\n    DiaChi: string\n    Email: string\n    Anh3x4: string\n}\n\nclass TheDocGia {\n    MaThe: string*\n    MaDocGia: string\n    NgayCap: DateTime\n    HanSuDung: DateTime\n    DaDongLePhi: bool\n    TrangThai: bool\n}\n\nclass DauSach {\n    MaDauSach: string\n    TenSach: string\n    NamXuatBan: int\n    SoLuongHienCo: int\n    MaTheLoai: string\n    MaNhaXuatBan: string\n}\n\nclass PhieuMuon {\n    MaPhieuMuon: string*\n    MaDocGia: string\n    MaNhanVien: string\n    NgayMuon: DateTime\n    NgayHenTra: DateTime\n}\n\nclass ChiTietPhieuMuon {\n    MaChiTiet: string*\n    MaPhieuMuon: string\n    MaDauSach: string\n    NgayTraThucTe: DateTime?\n    TinhTrangTra: string\n}\n\nclass PhieuPhat {\n    MaPhieuPhat: string*\n    MaChiTiet: string\n    MaNhanVien: string\n    NgayPhat: DateTime\n    LyDo: string\n    PhiPhat: decimal\n}\n\n&#39; ==========================================\n&#39; MỐI QUAN HỆ &amp; BẢN SỐ (RELATIONSHIPS)\n&#39; ==========================================\nNhanVien \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PhieuMuon : Lập phiếu\nDocGia \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PhieuMuon : Mượn sách\nNhanVien \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PhieuPhat : Lập phạt\nNhaXuatBan \&quot;1\&quot; --&gt; \&quot;0..*\&quot; DauSach : Xuất bản\nTheLoai \&quot;1\&quot; --&gt; \&quot;0..*\&quot; DauSach : Thuộc thể loại\nDocGia \&quot;1\&quot; --&gt; \&quot;0..*\&quot; TheDocGia : Sở hữu\nPhieuMuon \&quot;1\&quot; *-- \&quot;1..3\&quot; ChiTietPhieuMuon : Gồm chi tiết\nDauSach \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ChiTietPhieuMuon : Được mượn\nChiTietPhieuMuon \&quot;1\&quot; --&gt; \&quot;0..1\&quot; PhieuPhat : Phát sinh\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="77Bq5pEpaT3kebUpm2W9-177">
