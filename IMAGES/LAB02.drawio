        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide circle\nskinparam linetype ortho\nskinparam DefaultFontName Arial\nskinparam TableBackgroundColor white\n\n&#39; ==========================================\n&#39; CÁC THỰC THỂ / BẢNG CƠ SỞ DỮ LIỆU\n&#39; ==========================================\n\nentity \&quot;NhanVien\&quot; {\n  MaNhanVien : nvarchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  Ho : nvarchar(50)\n  Ten : nvarchar(50)\n  Phai : nvarchar(10)\n  NgaySinh : date\n  ChucVu : nvarchar(80)\n  SoDienThoai : nvarchar(20)\n}\n\nentity \&quot;TheLoai\&quot; {\n  MaTheLoai : nvarchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  TenTheLoai : nvarchar(100)\n}\n\nentity \&quot;NhaXuatBan\&quot; {\n  MaNhaXuatBan : nvarchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  DiaChi : nvarchar(250)\n  SoDienThoai : nvarchar(20)\n}\n\nentity \&quot;DocGia\&quot; {\n  MaDocGia : nvarchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  Ho : nvarchar(50)\n  Ten : nvarchar(50)\n  NgaySinh : date\n  Phai : nvarchar(10)\n  SoDienThoai : nvarchar(20)\n  DiaChi : nvarchar(250)\n  Email : nvarchar(150)\n  Anh3x4 : nvarchar(260)\n}\n\nentity \&quot;TheDocGia\&quot; {\n  MaThe : nvarchar(30) &lt;&lt;PK&gt;&gt;\n  --\n  MaDocGia : nvarchar(20) &lt;&lt;FK&gt;&gt;\n  NgayCap : date\n  HanSuDung : date\n  DaDongLePhi : bit\n  TrangThai : bit\n}\n\nentity \&quot;DauSach\&quot; {\n  MaDauSach : nvarchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  TenSach : nvarchar(200)\n  NamXuatBan : int\n  SoLuongHienCo : int\n  MaTheLoai : nvarchar(20) &lt;&lt;FK&gt;&gt;\n  MaNhaXuatBan : nvarchar(20) &lt;&lt;FK&gt;&gt;\n}\n\nentity \&quot;PhieuMuon\&quot; {\n  MaPhieuMuon : nvarchar(30) &lt;&lt;PK&gt;&gt;\n  --\n  MaDocGia : nvarchar(20) &lt;&lt;FK&gt;&gt;\n  MaNhanVien : nvarchar(20) &lt;&lt;FK&gt;&gt;\n  NgayMuon : date\n  NgayHenTra : date\n}\n\nentity \&quot;ChiTietPhieuMuon\&quot; {\n  MaChiTiet : nvarchar(35) &lt;&lt;PK&gt;&gt;\n  --\n  MaPhieuMuon : nvarchar(30) &lt;&lt;FK&gt;&gt;\n  MaDauSach : nvarchar(20) &lt;&lt;FK&gt;&gt;\n  NgayTraThucTe : date\n  TinhTrangTra : nvarchar(50)\n}\n\nentity \&quot;PhieuPhat\&quot; {\n  MaPhieuPhat : nvarchar(35) &lt;&lt;PK&gt;&gt;\n  --\n  MaChiTiet : nvarchar(35) &lt;&lt;FK&gt;&gt;\n  MaNhanVien : nvarchar(20) &lt;&lt;FK&gt;&gt;\n  NgayPhat : date\n  LyDo : nvarchar(250)\n  PhiPhat : decimal(18,0)\n}\n\n&#39; ==========================================\n&#39; MỐI LIÊN KẾT KHÓA NGOẠI (FOREIGN KEYS)\n&#39; ==========================================\n\nTheLoai ||--o{ DauSach\nNhaXuatBan ||--o{ DauSach\n\nDocGia ||--o{ TheDocGia\nDocGia ||--o{ PhieuMuon\nNhanVien ||--o{ PhieuMuon\n\nPhieuMuon ||--|{ ChiTietPhieuMuon\nDauSach ||--o{ ChiTietPhieuMuon\n\nChiTietPhieuMuon ||--o| PhieuPhat\nNhanVien ||--o{ PhieuPhat\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="okDMez13e2HT7EjOUe8C-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
