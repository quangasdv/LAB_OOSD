  <diagram id="MjaRzcqUUYE8RQdE_n5y" name="tuan tu">
    <mxGraphModel dx="1433" dy="859" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml Sequence_QuanLyNuocGiaiKhat\ntitle SƠ ĐỒ TUẦN TỰ (SEQUENCE DIAGRAM) - THÊM MỚI NƯỚC GIẢI KHÁT\nautonumber\nskinparam monochrome true\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam sequenceMessageAlign center\n\nactor \&quot;:NhanVien\&quot; as NV\nboundary \&quot;:FrmQuanLyNGK\&quot; as Frm\ncontrol \&quot;:NuocGiaiKhatController\&quot; as Ctrl\nentity \&quot;:NhanHieu\&quot; as NH\nentity \&quot;:NuocGiaiKhat\&quot; as NGK\ndatabase \&quot;:Database\&quot; as DB\n\n&#39; Luồng khởi tạo màn hình &amp; lấy danh mục nhãn hiệu\nNV -&gt; Frm: 1. MoManHinhQuanLyNGK()\nactivate Frm\nFrm -&gt; Ctrl: 2. LayDanhSachNhanHieu()\nactivate Ctrl\nCtrl -&gt; NH: 3. getDanhSachNhanHieu()\nactivate NH\nNH -&gt; DB: 4. SELECT * FROM NhanHieu\nactivate DB\nDB --&gt; NH: Trả về danh sách nhãn hiệu\ndeactivate DB\nNH --&gt; Ctrl: Trả về danh sách nhãn hiệu\ndeactivate NH\nCtrl --&gt; Frm: 5. HienThiDanhSachNhanHieu(dsNhanHieu)\ndeactivate Ctrl\nFrm --&gt; NV: 6. Hiển thị form nhập liệu và danh mục nhãn hiệu\n\n&#39; Luồng nhập thông tin và xác nhận thêm\nNV -&gt; Frm: 7. NhapThongTinNGK(maNGK, tenNGK, donViTinh, maLoai)\nNV -&gt; Frm: 8. Click \&quot;Lưu\&quot; (XacNhanThem)\n\nFrm -&gt; Ctrl: 9. ThemNuocGiaiKhat(maNGK, tenNGK, donViTinh, maLoai)\nactivate Ctrl\nCtrl -&gt; NGK: 10. KiemTraTonTai(maNGK)\nactivate NGK\nNGK -&gt; DB: 11. SELECT COUNT(*) FROM NuocGiaiKhat WHERE maNGK = ...\nactivate DB\nDB --&gt; NGK: Kết quả kiểm tra\ndeactivate DB\nNGK --&gt; Ctrl: TraVeKetQua(DaTonTai)\ndeactivate NGK\n\n&#39; Rẽ nhánh điều kiện: Trùng mã hoặc Thành công\nalt Mã NGK đã tồn tại (Trùng khóa chính)\n    Ctrl --&gt; Frm: 12. ThongBaoLoi(\&quot;Mã NGK đã tồn tại trên hệ thống!\&quot;)\n    Frm --&gt; NV: 13. Hiển thị thông báo lỗi trùng mã\nelse Mã NGK hợp lệ\n    Ctrl -&gt; NGK: 14. Them(maNGK, tenNGK, donViTinh, maLoai)\n    activate NGK\n    NGK -&gt; DB: 15. INSERT INTO NuocGiaiKhat VALUES (...)\n    activate DB\n    DB --&gt; NGK: Thực thi thành công\n    deactivate DB\n    NGK --&gt; Ctrl: XacNhanThanhCong()\n    deactivate NGK\n    Ctrl --&gt; Frm: 16. ThongBaoThanhCong(\&quot;Thêm mới nước giải khát thành công!\&quot;)\n    Frm -&gt; Frm: 17. CapNhatLaiBangDuLieu()\n    Frm --&gt; NV: 18. Hiển thị thông báo thành công và cập nhật lại bảng danh sách\nend\ndeactivate Ctrl\ndeactivate Frm\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="n4IY8WUGVvtn2vOaSZAa-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
