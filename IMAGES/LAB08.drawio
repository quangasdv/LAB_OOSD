  <diagram id="47yTHaD7qFH6JAfcQ7TY" name="class">
    <mxGraphModel dx="2977" dy="1289" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n&#39; ==============================================================================\n&#39; SƠ ĐỒ LỚP: HỆ THỐNG QUẢN LÝ CỬA HÀNG NƯỚC GIẢI KHÁT (LAB 1 - BÀI 2)\n&#39; Style: Giống 100% \&quot;he thong quan ly cong tac.drawio\&quot; (Không icon chấm tròn/chấm xanh)\n&#39; ==============================================================================\n\n&#39; --- TẮT TOÀN BỘ CÁC ICON HUY HIỆU VÀ CHẤM MÀU ---\nhide circle\nhide empty members\nskinparam classAttributeIconSize 0\n\n&#39; --- CẤU HÌNH GIAO DIỆN TỐI GIẢN (MONOCHROME) ---\nskinparam style strictuml\nskinparam shadowing false\nskinparam linetype ortho\nskinparam roundcorner 0\nskinparam backgroundColor #FFFFFF\n\n&#39; Font chữ Helvetica chuẩn draw.io\nskinparam defaultFontName \&quot;Helvetica\&quot;, Arial, sans-serif\nskinparam defaultFontSize 12\nskinparam defaultFontColor #28253D\n\n&#39; Hộp Class: Nền trắng, viền đen sắc nét, không icon\nskinparam class {\n    BackgroundColor #FFFFFF\n    BorderColor #000000\n    BorderThickness 1\n    HeaderBackgroundColor #FFFFFF\n    FontColor #000000\n    FontSize 13\n    FontStyle bold\n    AttributeFontColor #28253D\n    AttributeFontSize 12\n    AttributeFontName \&quot;Helvetica\&quot;, Arial, sans-serif\n    MethodFontColor #28253D\n    MethodFontSize 12\n    MethodFontName \&quot;Helvetica\&quot;, Arial, sans-serif\n}\n\n&#39; Đường liên kết: Màu đen, vuông góc, bản số rõ ràng\nskinparam arrow {\n    Color #000000\n    FontColor #28253D\n    FontSize 12\n    Thickness 1\n}\n\n&#39; ==============================================================================\n&#39; 14 LỚP (ĐỊNH DẠNG THUẦN CHỮ, KHÔNG CÓ BẤT KỲ ICON NÀO)\n&#39; ==============================================================================\n\nclass NhanHieu {\n    String maLoai (ID)\n    String tenLoai\n    --\n    ThemLoai()\n    SuaLoai()\n    XoaLoai()\n}\n\nclass NuocGiaiKhat {\n    String maNGK (ID)\n    String tenNGK\n    String donViTinh\n    int soLuongTon\n    --\n    Them()\n    Sua()\n    Xoa()\n    KiemTraTonKho()\n    CapNhatTonKho()\n}\n\nclass NhaCungUng {\n    String maNCU (ID)\n    String tenNCU\n    String diaChi\n    String soDienThoai\n    --\n    Them()\n    Sua()\n    Xoa()\n}\n\nclass KhachHang {\n    String maKH (ID)\n    String tenKH\n    String loaiKhach\n    String diaChi\n    String soDienThoai\n    --\n    Them()\n    Sua()\n    Xoa()\n}\n\nclass NhanVien {\n    String maNV (ID)\n    String tenNV\n    --\n    Them()\n    Sua()\n    Xoa()\n}\n\nclass DonDatHang {\n    String maDDH (ID)\n    Date ngayDatHang\n    Date ngayNhanHang\n    --\n    LapDonDatHang()\n    SuaDonDatHang()\n}\n\nclass ChiTietDonDatHang {\n    String maDDH (ID)\n    String maNGK (ID)\n    int soLuongDat\n    --\n    ThemChiTiet()\n}\n\nclass PhieuGiaoHang {\n    String maPhieuGiao (ID)\n    Date ngayGiao\n    Decimal soTienPhaiTra\n    --\n    LapPhieuGiao()\n    TinhTongTien()\n}\n\nclass ChiTietPhieuGiao {\n    String maPhieuGiao (ID)\n    String maNGK (ID)\n    int soLuongGiao\n    --\n    ThemChiTiet()\n}\n\nclass HoaDon {\n    String maHD (ID)\n    Date ngayLap\n    Decimal tongTien\n    --\n    LapHoaDon()\n    TinhTongTien()\n    ThanhToan()\n}\n\nclass ChiTietHoaDon {\n    String maHD (ID)\n    String maNGK (ID)\n    int soLuongMua\n    --\n    ThemChiTiet()\n}\n\nclass PhieuHenGiaoHang {\n    String maPhieuHen (ID)\n    Date ngayHenGiao\n    --\n    LapPhieuHen()\n}\n\nclass ChiTietPhieuHen {\n    String maPhieuHen (ID)\n    String maNGK (ID)\n    int soLuongHen\n    --\n    ThemChiTiet()\n}\n\nclass PhieuGhiNo {\n    String maPhieuNo (ID)\n    Date ngayLapPhieu\n    Decimal soTienNo\n    Date ngayDuKienTra\n    String lyDoNo\n    --\n    LapPhieuGhiNo()\n}\n\n&#39; ==============================================================================\n&#39; CÁC ĐƯỜNG KẾT NỐI VÀ BẢN SỐ\n&#39; ==============================================================================\n\n&#39; Phân hệ Danh mục &amp; Sản phẩm\nNhanHieu \&quot;1\&quot; -- \&quot;1..*\&quot; NuocGiaiKhat\nNhaCungUng \&quot;1\&quot; -- \&quot;1..*\&quot; NuocGiaiKhat\n\n&#39; Phân hệ Nhập hàng\nNhaCungUng \&quot;1\&quot; -- \&quot;1..*\&quot; DonDatHang\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; DonDatHang\nDonDatHang \&quot;1\&quot; -- \&quot;1..3\&quot; PhieuGiaoHang\nDonDatHang \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietDonDatHang\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietDonDatHang\n\nPhieuGiaoHang \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhieuGiao\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhieuGiao\n\n&#39; Phân hệ Bán hàng &amp; Khách hàng\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; HoaDon\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; HoaDon\nHoaDon \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietHoaDon\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietHoaDon\n\nHoaDon \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuHenGiaoHang\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuHenGiaoHang\nPhieuHenGiaoHang \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhieuHen\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhieuHen\n\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuGhiNo\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuGhiNo\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="R1Acw4LRzFWhEwJVwK9L-241">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10 10 20 30;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="NhanHieu" plantUmlId="cls_2" plantUmlBaseStyle="swimlane;collapsible=0;fontStyle=1;align=center;fontSize=12;fontColor=#28253D;startSize=26.49;spacingLeft=0;fillColor=#FFFFFF;strokeColor=#000000;childLayout=stackLayout;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;marginBottom=0;stackSpacing=0;marginTop=4;rounded=0;shadow=0;strokeWidth=1;fontFamily=Helvetica, Arial, sans-serif;swimlaneFillColor=#FFFFFF;" plantUmlBaseValue="NhanHieu" id="R1Acw4LRzFWhEwJVwK9L-242">
