  <diagram id="jSQVFuJK6c_7213yeNGA" name="Trang-5">
    <mxGraphModel dx="1875" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml Sequence_LapPhieuDangKy\nhide footbox\n\nskinparam style strictuml\nskinparam shadowing false\nskinparam monochrome true\n\nskinparam sequence {\n    BorderColor #000000\n    BackgroundColor #FFFFFF\n    LifeLineBorderColor #000000\n    LifeLineBackgroundColor #FFFFFF\n    ArrowColor #000000\n    ActorBorderColor #000000\n    ActorBackgroundColor #FFFFFF\n    ParticipantBorderColor #000000\n    ParticipantBackgroundColor #FFFFFF\n}\n\nactor \&quot;: KhachHang\&quot; as KH\nboundary \&quot;: FrmDangKyTour\&quot; as Frm\ncontrol \&quot;: DangKyTourService\&quot; as Srv\nentity \&quot;: Tour\&quot; as T\nentity \&quot;: PhieuDangKy\&quot; as PDK\nentity \&quot;: ThanhVienDoan\&quot; as TV\nentity \&quot;: PhieuThuTienCoc\&quot; as PT\ncontrol \&quot;: NotificationService\&quot; as Noti\n\nKH -&gt; Frm : Nhap thong tin doan &amp; so luong nguoi\nactivate Frm\n\nFrm -&gt; Srv : TinhToanKinhPhiVaCoc(maTour, soNguoi, coBaoHiem)\nactivate Srv\n\nSrv -&gt; T : layDonGiaTour(maTour)\nactivate T\nT --&gt;&gt; Srv : donGia\ndeactivate T\n\nSrv -&gt; Srv : tienCoc = soNguoi * donGia * 30%\nactivate Srv\ndeactivate Srv\n\nSrv --&gt;&gt; Frm : Hien thi tongKinhPhi, tienCoc\ndeactivate Srv\n\nFrm --&gt;&gt; KH : Kiem tra so lieu &amp; yeu cau dat coc\n\nKH -&gt; Frm : Click Xac nhan lap phieu &amp; thanh toan coc\n\nFrm -&gt; Srv : LapPhieuDangKy(maTour, thongTinDoan, dsThanhVien)\nactivate Srv\n\nSrv -&gt; Srv : Kiem tra soNguoi &gt;= 12\nactivate Srv\ndeactivate Srv\n\nalt Du lieu hop le (soNguoi &gt;= 12)\n    Srv -&gt; PDK : themPhieuDangKy(maPDK, maTour, thongTinDoan, tienCoc, \&quot;DaDatCoc\&quot;)\n    activate PDK\n    deactivate PDK\n\n    opt coBaoHiem == true\n        loop Voi moi thanh vien trong dsThanhVien\n            Srv -&gt; TV : themThanhVien(maPDK, hoTen, ngaySinh, cccd)\n            activate TV\n            deactivate TV\n        end\n    end\n\n    Srv -&gt; PT : themPhieuThuCoc(maPDK, tienCoc, ngayThu)\n    activate PT\n    deactivate PT\n\n    Srv -&gt; Noti : guiEmailXacNhan(email, maPDK, tienCoc)\n    activate Noti\n    Noti --&gt;&gt; Srv : thanhCong = true\n    deactivate Noti\n\n    Srv --&gt;&gt; Frm : KetQuaXuLy.Ok\nelse Khong du dieu kien (soNguoi &lt; 12)\n    Srv --&gt;&gt; Frm : KetQuaXuLy.Fail(\&quot;Khong du dieu kien doan (&lt; 12 nguoi)\&quot;)\nend\n\ndeactivate Srv\nFrm --&gt;&gt; KH : Thong bao ket qua lap phieu\ndeactivate Frm\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hqRjoRyyXIaix5F6Kwth-80">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
