  <diagram name="class" id="9Wn1Yhgh6pUYV5KcEcSC">
    <mxGraphModel dx="1048" dy="2249" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml Class_Phan_Tich_Quan_Ly_Tour_Du_Lich\n\nskinparam style strictuml\nskinparam classAttributeIconStyle none\nskinparam linetype ortho\nskinparam roundcorner 0\nskinparam monochrome true\nskinparam packageStyle rectangle\nskinparam shadowing false\nskinparam classFontSize 12\nskinparam classFontBold true\nskinparam classBackgroundColor #FFFFFF\nskinparam classBorderColor #000000\nskinparam arrowColor #000000\nskinparam arrowFontColor #000000\n\n&#39; Ẩn ngăn phương thức đúng chuẩn Class phân tích trong class_phan_tich.png\nhide methods\n\n&#39; ==========================================================\n&#39; KHỐI 1: QUẢN LÝ LỘ TRÌNH VÀ THÔNG TIN TOUR\n&#39; ==========================================================\nclass Tour {\n    String MaTour\n    String TenTour\n    Int SoNgay\n    Int SoDem\n    Decimal DonGia\n    String XuatPhatTu\n    String KetThucTai\n    String MoTa\n}\n\nclass NoiDungChan {\n    String MaNoiDungChan\n    String TenNoiDungChan\n    Int ThuTuDung\n    Boolean DoiPhuongTien\n    String PhuongTienTiepTheo\n    Boolean CoNoiAn\n    Boolean CoKhachSan\n    Int HangSaoKhachSan\n}\n\nclass DiemThamQuan {\n    String MaDiemTQ\n    String TenDiemTQ\n    String DiaDiem\n    String NoiDung\n    String YNghia\n}\n\n&#39; ==========================================================\n&#39; KHỐI 2: CHUYẾN ĐI VÀ ĐIỂM ĐÓN / BÁN VÉ CHO KHÁCH LẺ\n&#39; ==========================================================\nclass ChuyenDuLich {\n    String MaChuyen\n    Date NgayDi\n    Date NgayVe\n    Int SoLuongKhachToiDa\n    Int SoChoConTrong\n    String TrangThai\n}\n\nclass DiemDon {\n    String MaDiemDon\n    String TenDiemDon\n    String DiaChi\n    String GhiChu\n}\n\nclass DiemBanVe {\n    String MaDiemBan\n    String TenDiemBan\n    String DiaChi\n    String SoDienThoai\n    String NguoiPhuTrach\n}\n\nclass VeDuLich {\n    String MaVe\n    Date NgayBan\n    Decimal GiaVe\n    String TrangThai\n}\n\n&#39; ==========================================================\n&#39; KHỐI 3: PHÂN KHÚC KHÁCH HÀNG (KẾ THỪA)\n&#39; ==========================================================\nclass KhachHang {\n    String MaKH\n    String HoTen\n    String SoDienThoai\n    String Email\n    String DiaChi\n    String LoaiKhach\n}\n\nclass KhachDoan {\n    String TenCoQuanGiaDinh\n    String DiaChiCoQuan\n    String DienThoaiCoQuan\n    String NguoiDaiDien\n    String ChucVu\n}\n\nclass KhachLe {\n    String SoCMND_CCCD\n}\n\n&#39; ==========================================================\n&#39; KHỐI 4: ĐĂNG KÝ TOUR THEO ĐOÀN VÀ BẢO HIỂM\n&#39; ==========================================================\nclass PhieuDangKyDoan {\n    String MaPhieuDK\n    Date NgayLapPhieu\n    Date NgayKhoiHanhYeuCau\n    String DiaDiemDonYeuCau\n    Int SoNguoiDi\n    Boolean CoMuaBaoHiem\n    Decimal TienDatCoc\n    Decimal TongKinhPhi\n    Decimal TienConLai\n    String TrangThai\n}\n\nclass ThanhVienDoan {\n    String MaThanhVien\n    String HoTen\n    Date NgaySinh\n    String GioiTinh\n    String CMND_CCCD\n    String SoBaoHiem\n}\n\n&#39; ==========================================================\n&#39; KHỐI 5: PHÂN CÔNG HƯỚNG DẪN VIÊN (ĐIỀU HÀNH)\n&#39; ==========================================================\nclass NhanVienHDV {\n    String MaHDV\n    String HoTen\n    Date NgaySinh\n    String SoDienThoai\n    String Email\n    Decimal LuongCanBan\n    String ChuyenMon\n    String TrangThai\n}\n\nclass PhanCongHDV {\n    String MaPhanCong\n    Date NgayPhanCong\n    String VaiTro\n    Decimal PhuCapTour\n    String GhiChu\n}\n\n&#39; ==========================================================\n&#39; KHỐI 6: TÀI CHÍNH VÀ HẬU MÃI / KHẢO SÁT\n&#39; ==========================================================\nclass HoaDonThanhToan {\n    String MaHD\n    Date NgayLap\n    String LoaiHoaDon\n    Decimal SoTien\n    String HinhThucThanhToan\n    String NoiDung\n}\n\nclass PhieuKhaoSat {\n    String MaKhaoSat\n    Date NgayGui\n    Date NgayPhanHoi\n    Int DiemDanhGia\n    String GopYPhuongTien\n    String GopYKhachSan\n    String GopYAnUong\n    String GopYHDV\n    String YKienKhac\n}\n\n&#39; ==========================================================\n&#39; MỐI QUAN HỆ &amp; BẢN SỐ (RELATIONSHIPS &amp; MULTIPLICITIES)\n&#39; ==========================================================\n\n&#39; Kế thừa Khách hàng\nKhachHang &lt;|-- KhachDoan\nKhachHang &lt;|-- KhachLe\n\n&#39; Lộ trình Tour\nTour \&quot;1\&quot; *-- \&quot;1..*\&quot; NoiDungChan\nNoiDungChan \&quot;1\&quot; o-- \&quot;0..*\&quot; DiemThamQuan\n\n&#39; Nhánh Tour theo Chuyến (Khách lẻ)\nTour \&quot;1\&quot; *-- \&quot;0..*\&quot; ChuyenDuLich\nChuyenDuLich \&quot;1\&quot; *-- \&quot;0..*\&quot; VeDuLich\nChuyenDuLich \&quot;1..*\&quot; --&gt; \&quot;1..*\&quot; DiemDon\nDiemBanVe \&quot;1\&quot; --&gt; \&quot;0..*\&quot; VeDuLich\nKhachLe \&quot;1\&quot; --&gt; \&quot;0..*\&quot; VeDuLich\nVeDuLich \&quot;1\&quot; --&gt; \&quot;1\&quot; HoaDonThanhToan\n\n&#39; Nhánh Tour theo Đoàn\nKhachDoan \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PhieuDangKyDoan\nTour \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; PhieuDangKyDoan\nPhieuDangKyDoan \&quot;1\&quot; *-- \&quot;0..*\&quot; ThanhVienDoan\nPhieuDangKyDoan \&quot;1\&quot; --&gt; \&quot;1..2\&quot; HoaDonThanhToan\n\n&#39; Phân công nhân sự HDV\nNhanVienHDV \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PhanCongHDV\nChuyenDuLich \&quot;1\&quot; --&gt; \&quot;1\&quot; PhanCongHDV\nPhieuDangKyDoan \&quot;1\&quot; --&gt; \&quot;1..*\&quot; PhanCongHDV\n\n&#39; Khảo sát đánh giá sau tour\nPhieuDangKyDoan \&quot;1\&quot; --&gt; \&quot;0..1\&quot; PhieuKhaoSat\nChuyenDuLich \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PhieuKhaoSat\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="y668U10GDPmN0H-uZPSh-163">
